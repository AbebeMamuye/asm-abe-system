{
  "name": "asset-management-ims",
  "version": "2.0.0",
  "description": "Offline-first General-Purpose Asset & Property Management System built with Electron + React",
  "main": "./out/main/index.js",
  "author": "AbeTech",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "start": "node bin/ams-web.js",
    "web": "node bin/ams-web.js",
    "web:start": "node bin/ams-web.js",
    "web:build": "npm run web:build:client && npm run web:build:server",
    "web:build:client": "vite build --config vite.config.mjs",
    "web:build:server": "esbuild src/server/server.ts --bundle --platform=node --format=cjs --external:better-sqlite3 --outfile=dist-server/server.js",
    "web:dev": "concurrently \"vite --config vite.config.mjs\" \"node bin/ams-web.js\"",
    "dev": "node bin/ams-web.js",
    "dev:electron": "npx electron-vite dev",
    "build": "npm run web:build",
    "build:electron": "npx electron-vite build",
    "build:win": "npm run build:electron && npx electron-builder --win",
    "build:mac": "npm run build:electron && npx electron-builder --mac",
    "build:linux": "npm run build:electron && npx electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@types/file-saver": "^2.0.7",
    "@types/qrcode": "^1.5.6",
    "better-sqlite3": "^12.8.0",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "express": "^5.2.1",
    "file-saver": "^2.0.5",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^1.8.0",
    "qrcode": "^1.5.4",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^2.1.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron/rebuild": "^4.0.3",
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "electron": "^39.8.10",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.2.2",
    "vite": "^5.4.21"
  }
}
